  "claim_to_evidence_map": [
    {
      "question": "Does the tested source-reading judge add useful reports?",
      "mechanism": "Same full source bodies and semantic user question; supporting-source tools versus corrected supplied-source-only procedure.",
      "comparison": "Eight R1 novel pairs and nine R2 novel pairs; separate protocols, one response sample per rendered request.",
      "observation": "Both arms report checkpoint construction in R1 and the test-tool factory in R2. Certain paired report decisions agree: 6/6 per round.",
      "interpretation": "No added report established; this is not proof source access never helps. R2 procedures differ, so no pure same-prompt causal claim.",
      "decision": "Do not enable this recipe by default; retain bounded tools and traces for investigation."
    },
    {
      "question": "Did supporting context clarify any decisions?",
      "mechanism": "Retrieve definitions, bindings and delegated helper contracts named as missing by body-only responses.",
      "comparison": "Corrected R2 body-only six certain/three uncertain versus teacher eight certain/one uncertain.",
      "observation": "Plugin context and proxy URL contracts are source-supported non-reporting decisions with tools and uncertain body-only. Tiny file-mutation predicate uncertain in both.",
      "interpretation": "Two observed source-supported uncertainty resolutions; not report recoveries and not a stable causal effect estimate.",
      "decision": "Retain this narrower useful finding without claiming report-recall improvement."
    },
    {
      "question": "Can generic facts derived from tool traces improve one-shot reporting?",
      "mechanism": "Fixed imports, nearby-line and lexical-reference extraction recipe.",
      "comparison": "Six separate development families, 24 valid requests across two models and two context arms.",
      "observation": "Zero recoveries, losses or new false reports in each model.",
      "interpretation": "The tested generic recipe did not improve reporting on this panel.",
      "decision": "Stop that recipe; no blanket conclusion about all context extraction."
    },
    {
      "question": "Does the Windows source dispute change report recovery?",
      "mechanism": "Count archived prior-positive versus current related assessment separately.",
      "comparison": "Same frozen teacher control output; no paired control baseline.",
      "observation": "R2 supported teacher reports one excluding dispute, two including prior positive. Established paired recoveries zero either way.",
      "interpretation": "Neither unqualified gain nor confirmed false report.",
      "decision": "Preserve both assessments and the archived prior label."
    }
  ],
